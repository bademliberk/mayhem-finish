HELIUS_API_KEY=
DB_PATH=data/collector.sqlite
FIRST_CHECK_SECONDS=30
RECHECK_SECONDS=30
OBSERVATION_SECONDS=86400
MIN_MARKET_CAP_SOL=2
MAX_MARKET_CAP_SOL=5
MIN_LIQUIDITY_SOL=0.005
RPC_INTERVAL_MS=150
HISTORY_PAGES_PER_PASS=10
BACKFILL_SECONDS=60

# Used by paper and opt-in paper:trial; no wallet or live transaction submission.
# Paper watches start at discovery (screening settings above are monitor-only).
# Legacy drawdown profiles: activate preprocessed below 2 SOL; pause after 10s unchanged
# when unheld; rotate idle watches after 60s. Agent-sell trials use confirmed feeds, not preprocessed.
MAX_TRADE_COUNT=25
PAPER_ENTRIES_ENABLED=true
# Simulation assumptions, not verified on-chain fees or guaranteed fills.
# Unset: legacy profiles use 200 bps; agent-sell-liquidity uses 125 bps.
# An explicit value overrides BOTH, including 200 already present in an existing .env.
# PAPER_SWAP_FEE_BPS=200
PAPER_NETWORK_FEE_LAMPORTS=10000
PAPER_BUY_SLIPPAGE_BPS=500
PAPER_SELL_SLIPPAGE_BPS=500
# Concurrent watched mints, including curve-only watches and held positions (1–20).
# Legacy named trials pin this value to 10 or 20; the agent profile uses PAPER_AGENT_MAX_WATCHES.
PAPER_MAX_WATCHES=10
PAPER_QUEUE_LIMIT=1000
PAPER_MAX_STATE_AGE_MS=5000
PAPER_ORDER_TTL_MS=10000
# Optional independent trial directory and experimental entry-quality thresholds.
# PAPER_TRIAL_DIR=data/paper-trials
# PAPER_MIN_LIQUIDITY_MULTIPLE=2
# PAPER_MAX_ROUND_TRIP_LOSS_BPS=1000

# Opt-in agent-sell-liquidity profile only; defaults shown, not applied to legacy profiles.
# Future explicit launch (paid feeds; not run by tests):
# PAPER_TRIAL_DIR=data/paper-trials-agent-v1 npm run paper:trial -- agent-sell-liquidity
# Defaults to 20 watches; agent override supports 1–1000 (more watches increase provider usage).
# PAPER_AGENT_MAX_WATCHES=20
# Confirmed Mayhem sells + confirmed curve accounts, no preprocessed feed.
# No market-cap/peak/drop gates. Quality and liquidity-risk guards are enabled.
# Freeze min(max swap, floor(post-sell real SOL * fraction bps / 10000)); never resize at fill.
# PAPER_AGENT_FRACTION_BPS=1200
# PAPER_AGENT_MAX_SWAP_LAMPORTS=10000000
# Opt-in: skip entries whose budget would hit that cap (real SOL >= cap / fraction, ~0.083 SOL by default).
# Changes trial identity; use a new PAPER_TRIAL_DIR.
# PAPER_AGENT_SKIP_CAPPED=true
# Opt-in stop-loss on the full-sale net: 6000 = sell once the position is worth 60% less than it cost.
# A mandatory exit (latched, retried until sold); priority below timeout and liquidity risk. Changes trial identity.
# PAPER_AGENT_STOP_LOSS_BPS=6000
# Trading WebSocket host: mainnet (default) or beta (Helius Gatekeeper; faster, no published SLA). Runtime setting.
# HELIUS_WS_HOST=beta
# Speed (opt-in; each changes trial identity): processed feeds instead of confirmed (may act on sells that later fail),
# and fast entries that send from the sell event's reserves with no signature recheck or curve refetch.
# PAPER_AGENT_FEED_COMMITMENT=processed
# PAPER_AGENT_FAST_ENTRY=true
# Entry band on market cap in SOL, checked at the signal (opt-in; changes trial identity).
# PAPER_AGENT_MIN_ENTRY_MC_SOL=15
# PAPER_AGENT_MAX_ENTRY_MC_SOL=30
# Minimum real SOL at both signal and fill.
# PAPER_AGENT_MIN_REAL_SOL_LAMPORTS=10000000
# Open entry cost plus pending-buy budget AND modeled network fees; pending sells do not release it.
# PAPER_AGENT_MAX_EXPOSURE_LAMPORTS=50000000
# Holding deadline from confirmed entry-fill snapshot; requests an exit, never fabricates a fill.
# PAPER_AGENT_HOLD_SLOTS=80
# Net profit target and full-sale-gross liquidity-risk multiple.
# PAPER_AGENT_PROFIT_BPS=3000
# PAPER_AGENT_EXIT_MULTIPLE=2
# Priority: graduation > timeout > liquidity risk > profit. V3 mandatory exits model terminal
# recovery/burn/closure or zero-recovery write-off; no on-chain action or fallback polling.
# To explicitly use the agent profile's default fee: PAPER_SWAP_FEE_BPS=125
# Model excludes refundable rent/real non-fill costs; this is not exact wallet replication.

# ---- Live agent trial (REAL MONEY) ----
# npm run live:trial   (agent-sell-liquidity only; uses the PAPER_AGENT_* strategy settings above)
# Dry run first: LIVE_DRY_RUN=true simulates every buy against mainnet and records passing ones at the modeled
# quote; sells are built but not simulated. Nothing is broadcast. A funded wallet is still required (balance checks).
# Live and dry-run trials use separate databases under LIVE_TRIAL_DIR (default data/live-trials).
# AS_WALLET_SECRET=            # base58 secret or solana-keygen JSON array; never logged or stored
# LIVE_DRY_RUN=true
# Buys never spend more swap SOL than their budget: PAPER_BUY_SLIPPAGE_BPS is taken as fewer tokens, not more SOL.
# LIVE_TRIAL_DIR=data/live-trials
# LIVE_MIN_WALLET_SOL=0.05      # refuse to start / halt entries below this
# LIVE_MAX_LOSS_SOL=0.1         # no buy if realized loss + open entry costs + this buy + worst-case fees could exceed this
# LIVE_TRADE_RESERVE_SOL=0.003  # kept free per buy for token-account rent, tip and fees
# LIVE_EXIT_SLIPPAGE_BPS=2000   # mandatory exits accept a fresh quote less this; profit exits keep PAPER_SELL_SLIPPAGE_BPS
# LIVE_MAX_BUYS_IN_FLIGHT=1      # 1-4 live buys at once; >1 counts in-flight budgets against limits
# LIVE_CHECK_BALANCE_PER_BUY=true # false: use a balance cached every 5 s instead of an RPC per buy
# LIVE_FORCE_SELL=false         # true: every sell has a zero minimum, so it never fails on slippage (accepts any price)
# LIVE_BURN_ONLY_AFTER_EXIT_FAILURES=0 # 0 disables; N irreversibly burns and closes after N mandatory-exit build failures
# LIVE_SHUTDOWN_DRAIN_MS=120000  # first SIGINT/SIGTERM halts entries and drains positions; second signal forces shutdown
# AS_SENDER_URL=auto            # fastest Helius Sender region, or an explicit http://<region>-sender.helius-rpc.com
# AS_TIP_SOL=0.000005           # minimum for swqos_only Sender routing
# Priority fee: by default a Helius getPriorityFeeEstimate for the curve's accounts at AS_PRIORITY_LEVEL,
# clamped to [AS_MIN_PRIORITY_MICROLAMPORTS, AS_MAX_PRIORITY_MICROLAMPORTS]. Set AS_PRIORITY_MICROLAMPORTS for a fixed price.
# At 150k CU, 2,000,000 microlamports costs 0.0003 SOL per transaction (the loss budget counts this worst case).
# AS_PRIORITY_FEES_ENABLED=true       # false: 1-microlamport price, no estimates (Sender requires the instruction)
# AS_PRIORITY_LEVEL=High               # Low | Medium | High | VeryHigh
# AS_MIN_PRIORITY_MICROLAMPORTS=10000
# AS_MAX_PRIORITY_MICROLAMPORTS=2000000
# AS_PRIORITY_MICROLAMPORTS=
# AS_CURVE_BUY_CU=150000
# AS_CURVE_SELL_CU=90000
# AS_CONFIRM_TIMEOUT_MS=20000
