HELIUS_API_KEY=
DB_PATH=data/collector.sqlite
FIRST_CHECK_SECONDS=30
RECHECK_SECONDS=30
OBSERVATION_SECONDS=86400
MIN_MARKET_CAP_SOL=2
MAX_MARKET_CAP_SOL=5
MIN_LIQUIDITY_SOL=0.005
RPC_INTERVAL_MS=150
HISTORY_PAGES_PER_PASS=10
BACKFILL_SECONDS=60

# Used by paper and opt-in paper:trial; no wallet or live transaction submission.
# Paper watches start at discovery (screening settings above are monitor-only).
# Activate preprocessed below 2 SOL; pause after 10s unchanged when unheld; rotate idle watches after 60s.
MAX_TRADE_COUNT=25
PAPER_ENTRIES_ENABLED=true
# Simulation assumptions, not verified on-chain fees or guaranteed fills.
PAPER_SWAP_FEE_BPS=200
PAPER_NETWORK_FEE_LAMPORTS=10000
PAPER_BUY_SLIPPAGE_BPS=500
PAPER_SELL_SLIPPAGE_BPS=500
# Concurrent watched mints, including curve-only watches and held positions (1–20).
# Named trials pin this value to their profile's 10 or 20 watches.
PAPER_MAX_WATCHES=10
PAPER_QUEUE_LIMIT=1000
PAPER_MAX_STATE_AGE_MS=5000
PAPER_ORDER_TTL_MS=10000
# Optional independent trial directory and experimental entry-quality thresholds.
# PAPER_TRIAL_DIR=data/paper-trials
# PAPER_MIN_LIQUIDITY_MULTIPLE=2
# PAPER_MAX_ROUND_TRIP_LOSS_BPS=1000
