HELIUS_API_KEY=
DB_PATH=data/collector.sqlite
FIRST_CHECK_SECONDS=30
RECHECK_SECONDS=30
OBSERVATION_SECONDS=86400
MIN_MARKET_CAP_SOL=2
MAX_MARKET_CAP_SOL=5
MIN_LIQUIDITY_SOL=0.005
RPC_INTERVAL_MS=150
HISTORY_PAGES_PER_PASS=10
BACKFILL_SECONDS=60

# Used by paper and opt-in paper:trial; no wallet or live transaction submission.
# Paper watches start at discovery (screening settings above are monitor-only).
# Legacy drawdown profiles: activate preprocessed below 2 SOL; pause after 10s unchanged
# when unheld; rotate idle watches after 60s. Agent-sell trials use confirmed feeds, not preprocessed.
MAX_TRADE_COUNT=25
PAPER_ENTRIES_ENABLED=true
# Simulation assumptions, not verified on-chain fees or guaranteed fills.
# Unset: legacy profiles use 200 bps; agent-sell-liquidity uses 125 bps.
# An explicit value overrides BOTH, including 200 already present in an existing .env.
# PAPER_SWAP_FEE_BPS=200
PAPER_NETWORK_FEE_LAMPORTS=10000
PAPER_BUY_SLIPPAGE_BPS=500
PAPER_SELL_SLIPPAGE_BPS=500
# Concurrent watched mints, including curve-only watches and held positions (1–20).
# Named trials pin this value to their profile's 10 or 20 watches.
PAPER_MAX_WATCHES=10
PAPER_QUEUE_LIMIT=1000
PAPER_MAX_STATE_AGE_MS=5000
PAPER_ORDER_TTL_MS=10000
# Optional independent trial directory and experimental entry-quality thresholds.
# PAPER_TRIAL_DIR=data/paper-trials
# PAPER_MIN_LIQUIDITY_MULTIPLE=2
# PAPER_MAX_ROUND_TRIP_LOSS_BPS=1000

# Opt-in agent-sell-liquidity profile only; defaults shown, not applied to legacy profiles.
# Future explicit launch (paid feeds; not run by tests):
# PAPER_TRIAL_DIR=data/paper-trials-agent-v1 npm run paper:trial -- agent-sell-liquidity
# Pins 20 watches; confirmed Mayhem sells + confirmed curve accounts, no preprocessed feed.
# No market-cap/peak/drop gates. Quality and liquidity-risk guards are enabled.
# Freeze min(max swap, floor(post-sell real SOL * fraction bps / 10000)); never resize at fill.
# PAPER_AGENT_FRACTION_BPS=1200
# PAPER_AGENT_MAX_SWAP_LAMPORTS=10000000
# Minimum real SOL at both signal and fill.
# PAPER_AGENT_MIN_REAL_SOL_LAMPORTS=10000000
# Open entry cost plus pending-buy budget AND modeled network fees; pending sells do not release it.
# PAPER_AGENT_MAX_EXPOSURE_LAMPORTS=50000000
# Holding deadline from confirmed entry-fill snapshot; requests an exit, never fabricates a fill.
# PAPER_AGENT_HOLD_SLOTS=80
# Net profit target and full-sale-gross liquidity-risk multiple.
# PAPER_AGENT_PROFIT_BPS=3000
# PAPER_AGENT_EXIT_MULTIPLE=2
# Priority: graduation > timeout > liquidity risk > profit. Illiquid holdings can remain blocked.
# To explicitly use the agent profile's default fee: PAPER_SWAP_FEE_BPS=125
# Model excludes refundable rent/real non-fill costs; this is not exact wallet replication.
